{
  "scene_name": "flat",
  "d_model": 512,
  "nhead": 8,
  "pre_layers": 2,
  "post_layers": 2,
  "ff_mult": 4,
  "dropout": 0.1,
  "knn_k": 32,
  "knn_chunk": 1024,
  "local_query_chunk": 1024,
  "cross_pair_chunk": 16,
  "droppath_rate": 0.10,
  "gamma_init": 1e-3,
  "zero_init_residual": false,
  "zero_init_decoder": true,
  "torch_compile": true,
  "torch_compile_backend": "inductor",
  "torch_compile_mode": "default",
  "torch_compile_fullgraph": false,
  "torch_compile_dynamic": false,
  "torch_compile_suppress_errors": true,

  "batch_size": 4,
  "grad_accum_steps": 2,
  "num_workers": 8,
  "epochs": 40,
  "lr": 1.2e-4,
  "weight_decay": 3e-4,
  "min_lr": 1e-5,
  "warmup_ratio": 0.05,
  "c4_rotation_augmentation": true,
  "center_loss_weight": 0.1,
  "edge_loss_weight": 20.0,

  "step_profiler_enabled": true,
  "step_profiler_epoch": 1,
  "step_profiler_warmup_steps": 5,
  "step_profiler_num_steps": 20,

  "eval_batch_size": 64,
  "eval_num_workers": 8,

  "train_npz": "data/multi_sphere_flat/preprocessed/fine/train.store",
  "validate_npz": "data/multi_sphere_flat/preprocessed/fine/validate.store",
  "test_npz": "data/multi_sphere_flat/preprocessed/fine/test.store",
  "idx_cache_dir_train": "data/multi_sphere_flat/idx_cache/fine_train",
  "idx_cache_dir_validate": "data/multi_sphere_flat/idx_cache/fine_validate",
  "idx_cache_dir_test": "data/multi_sphere_flat/idx_cache/fine_test",
  "save_dir": "out/multi_sphere_flat/checkpoint/fine",
  "log_file": "out/multi_sphere_flat/logs/fine_train.log",
  "plot_file": "out/multi_sphere_flat/plots/fine_training_metrics.png",
  "results_dir": "out/multi_sphere_flat/results",
  "coarse_ckpt_path": "out/multi_sphere_flat/checkpoint/coarse/best_validate_error_model.pth",

  "use_knn_cache": true,
  "knn_cache_format": "aggregate"
}
