{
  "scene_name": "jenga_tower",
  "d_model": 768,
  "nhead": 6,
  "pre_layers": 4,
  "post_layers": 2,
  "ff_mult": 4,
  "dropout": 0,
  "knn_k": 32,
  "knn_chunk": 1024,
  "local_query_chunk": 1024,
  "cross_pair_chunk": 16,
  "droppath_rate": 0.1,
  "gamma_init": 0.001,
  "zero_init_residual": false,
  "zero_init_decoder": true,
  "torch_compile": true,
  "torch_compile_backend": "inductor",
  "torch_compile_mode": "default",
  "torch_compile_fullgraph": false,
  "torch_compile_dynamic": false,
  "torch_compile_suppress_errors": true,
  "batch_size": 8,
  "grad_accum_steps": 1,
  "num_workers": 8,
  "epochs": 40,
  "lr": 0.00012,
  "weight_decay": 0.0001,
  "min_lr": 0.00001,
  "warmup_ratio": 0.05,
  "center_loss_weight": 0.1,
  "edge_loss_weight": 20,
  "step_profiler_enabled": true,
  "step_profiler_epoch": 1,
  "step_profiler_warmup_steps": 5,
  "step_profiler_num_steps": 20,
  "eval_batch_size": 64,
  "eval_num_workers": 8,
  "train_npz": "data/jenga_tower/preprocessed/fine/train.store",
  "validate_npz": "data/jenga_tower/preprocessed/fine/validate.store",
  "test_npz": "data/jenga_tower/preprocessed/fine/test.store",
  "idx_cache_dir_train": "data/jenga_tower/idx_cache/fine_train",
  "idx_cache_dir_validate": "data/jenga_tower/idx_cache/fine_validate",
  "idx_cache_dir_test": "data/jenga_tower/idx_cache/fine_test",
  "save_dir": "out/jenga_tower/checkpoint/fine",
  "log_file": "out/jenga_tower/logs/fine_train.log",
  "plot_file": "out/jenga_tower/plots/fine_training_metrics.png",
  "results_dir": "out/jenga_tower/results",
  "coarse_ckpt_path": "out/jenga_tower/checkpoint/coarse/best_validate_error_model.pth",
  "use_knn_cache": true,
  "knn_cache_format": "aggregate"
}
